# Hosted board — existing Supabase project "crosscheck"
SUPABASE_URL=
SUPABASE_ANON_KEY=
STORE_SECRET=

# Production moderation. Local default is `dev-mod` when unset.
MOD_KEY=

# Paid Solana RPC (Helius or QuickNode). Public endpoints are used as failover.
SOLANA_RPC=

# Vercel Cron bearer. Required in production; local cron is open when unset.
CRON_SECRET=

# Optional tape alerts. Leave blank to skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional. Used if SOLANA_RPC is not a Helius URL with ?api-key=
HELIUS_API_KEY=

# Incoming Helius enhanced webhook. Create a successful BURN webhook for the
# $ANSEM mint pointing at /api/webhooks/helius. Send this secret as
# Authorization: Bearer <secret>. Local default is `dev-webhook` when unset.
HELIUS_WEBHOOK_SECRET=

# Closed-tab tape filter. `watch,radar` (default) sends watched mints and
# Gold/Diamond events. `all` is the unfiltered firehose.
ALERT_FILTER=
